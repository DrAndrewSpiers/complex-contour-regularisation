Cell["Stage 3: second order, 1/rho^2 case", "Section",ExpressionUUID->"7ce78cee-1eb8-4124-bd35-3daaca7728ca"],

Cell["\<\
Q = \"Product\" (Q[A,B] = A B).  SS and SR: continued source on the contour \
inside the tube, real source outside; RR: real line throughout. Boundary \
conditions from the analytic particular solutions (modes of q^2 Log rho, q c0 \
rho + q c1 (r0 rho + (r cos theta - r0) rho/2), c0^2 r^2/6 + c0 c1 r^3 \
cos(theta)/5 + c1^2 r^4 cos(theta)^4/12).\
\>", "Text",ExpressionUUID->"594588c0-bf23-4872-9ea1-346fc14935d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q", " ", "=", " ", "\"\<Product\>\""}], ";", " ", 
  RowBox[{"l", " ", "=", " ", "2"}], ";", " ", 
  RowBox[{"rMin", " ", "=", " ", 
   RowBox[{"csPar", "[", "\"\<rMin\>\"", "]"}]}], ";", " ", 
