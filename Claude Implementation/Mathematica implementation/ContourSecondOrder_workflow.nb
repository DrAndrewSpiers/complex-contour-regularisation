               RowBox[{"res1", "[", "lp", "]"}], ",", " ", "r"}], "]"}]}], ";",
             " ", "f"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"lp", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"phiRTilde", " ", "=", " ", 
   RowBox[{"Association", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
