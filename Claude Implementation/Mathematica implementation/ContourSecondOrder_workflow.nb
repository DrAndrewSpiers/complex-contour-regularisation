     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<l\>\"", ",", " ", "\"\<alpha\>\"", ",", 
        " ", "\"\<beta\>\""}], "}"}]}], "}"}]}]}], "]"}]], "Input",ExpressionU\
UID->"3fce51a8-23a9-44ab-8797-66cb9871436f"],

