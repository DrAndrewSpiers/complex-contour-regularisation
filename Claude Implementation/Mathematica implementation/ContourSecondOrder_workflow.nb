        RowBox[{"res1", "[", "lp", "]"}], "[", "\"\<sol2\>\"", "]"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"lp", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"phiRLine", " ", "=", " ", 
   RowBox[{"Association", "@", 
