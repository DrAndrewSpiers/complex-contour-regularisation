    RowBox[{"{", 
     RowBox[{"l", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], " ", "//", 
  " ", "TableForm"}]], "Input",ExpressionUUID->"9a99b8c8-a1f3-477c-84c2-\
183eeefb58da"],

Cell["\<\
D_l(r) = Re psi_p(r+i0) - G_l(r) = alpha r^l + beta r^(-l-1).  Result: \
alpha_0 = r0, beta_0 = r0^2; D_1 = 0; alpha_l = r0^(1-l)/(2l+1), beta_l = 0 \
for l >= 2 (the note's 'mirror' choice), not the note's beta_l = \
r0^(l+2)/(2l+1).\
\>", "Text",ExpressionUUID->"ffabf39a-6b67-4ccd-ba61-3f4add9b963c"],

