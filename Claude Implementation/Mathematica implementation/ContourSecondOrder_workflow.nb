            RowBox[{"phiRAnalytic", "[", "lp", "]"}], "[", "rMin", "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{
             RowBox[{"phiRAnalytic", "[", "lp", "]"}], "'"}], "[", "rMin", 
            "]"}]}], "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"lp", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"5dac502c-3436-4235-858e-84453c690295"],

Cell["SS", "Subsection",ExpressionUUID->"64d4105c-f46c-4f83-96bb-9465488e4413"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Neumann", ":", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"1", "/", 
         RowBox[{"rho", "^", "2"}]}], "]"}], "_l"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Pi", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "1"}], ")"}]}], "]"}], " ", "Q_l", 
      RowBox[{
       RowBox[{"(", "x", ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"r", " ", "r0"}], ")"}]}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"continued", " ", "with", " ", "2", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"z", "+", "r0"}], "]"}]}], " ", "-", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"z", "-", "r0"}], "]"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"ssSourceModeExpr", "[", 
   RowBox[{
   "Q", ",", " ", "l", ",", " ", "zVar", ",", " ", "\"\<continued\>\""}], 
   "]"}]}]], "Input",ExpressionUUID->"4bf57a38-f414-4a23-be02-c8c77e14341b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"solSS", " ", "=", " ", 
   RowBox[{"pieceAnalyticSolution", "[", 
    RowBox[{"Q", ",", " ", "\"\<SS\>\"", ",", " ", "l"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSS", " ", "=", " ", 
   RowBox[{"threeRegionSolve", "[", 
    RowBox[{"l", ",", " ", 
     RowBox[{"ssSourceReal", "[", 
