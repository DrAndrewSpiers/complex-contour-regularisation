     RowBox[{"l", ",", " ", 
      RowBox[{
       RowBox[{"dsolveSingularMode", "[", "l", "]"}], "[", "zVar", "]"}]}], 
     "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"l", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], " ", "//", 
  " ", "TableForm"}]], "Input",ExpressionUUID->"8f1e919a-a220-48b5-95cb-\
a33f7a5e2860"],

