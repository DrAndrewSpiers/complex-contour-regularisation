Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", 
       RowBox[{"1.", " ", "PARAMETERS"}]}], "&"}], " ", "COMPLEX", " ", 
     "CONTOUR"}], "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "==="}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lMode", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"order", "=", "12"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radius", "=", 
   RowBox[{"1", "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amplitude", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aL", "=", 
   RowBox[{"r0", "-", "radius"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aR", "=", 
   RowBox[{"r0", "+", "radius"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wp", "=", "30"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "a_", "]"}], "=", 
   RowBox[{"a", "+", 
    RowBox[{"I", "*", 
     RowBox[{"(", 
      RowBox[{"amplitude", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "-", "r0"}], ")"}], "/", "radius"}], ")"}], "^", 
           "2"}]}], ")"}], "^", "6"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yPrime", "[", "a_", "]"}], "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"y", "[", "a", "]"}], ",", "a"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"yDoublePrime", "[", "a_", "]"}], "=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"y", "[", "a", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", 
    RowBox[{"2.", " ", "AUTOMATED", " ", "ANALYTIC", " ", "FIELDS", " ", 
     RowBox[{"(", 
      RowBox[{"UPDATED", " ", "FOR", " ", "BVP"}], ")"}]}], "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "==="}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"radialODE", "[", 
    RowBox[{"psi_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"psi", "''"}], "[", "r", "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "/", "r"}], ")"}], "*", 
     RowBox[{
      RowBox[{"psi", "'"}], "[", "r", "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"lMode", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"lMode", "+", "1"}], ")"}], "/", 
        RowBox[{"r", "^", "2"}]}]}], ")"}], "*", 
     RowBox[{"psi", "[", "r", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"complexSource", "[", "r_", "]"}], ":=", 
    RowBox[{"I", "/", 
     RowBox[{"(", 
