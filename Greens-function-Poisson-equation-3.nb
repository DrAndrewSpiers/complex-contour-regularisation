Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ErrorPlot", "[", "ld", "]"}], "=", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"phiContour", "[", "ld", "]"}], "[", "r", "]"}], "]"}], "-", 
          RowBox[{"(", 
           RowBox[{"Re", "[", 
            RowBox[{"PhiLpwDelta", "[", "ld", "]"}], "]"}], ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"phiContour", "[", "ld", "]"}], "[", "r", "]"}], "]"}], 
         ")"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "1", ",", "10"}], "}"}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Contour Error\>\"", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Error l=\>\"", ",", "ld"}], "}"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<error\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ",", 
