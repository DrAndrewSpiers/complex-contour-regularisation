Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"l", "\[Dash]", 
    RowBox[{"mode", " ", "Poisson", " ", 
     RowBox[{"Green", "'"}], "s", " ", "function", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"regular", " ", "at", " ", "0"}], ",", 
       RowBox[{"decays", " ", "at", " ", "Infinity"}]}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"gL", ",", "PhiL"}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gL", "[", 
      RowBox[{
       RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "rp_"}], 
      "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"r", ",", "rp"}], "]"}], "^", "l"}], "/", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"r", ",", "rp"}], "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Given", " ", "an", " ", "l"}], "\[Dash]", 
     RowBox[{"mode", " ", "radial", " ", "source", " ", 
      RowBox[{"S_l", "[", "r", "]"}]}], ",", 
     RowBox[{"the", " ", "solution", " ", "is"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiL", "[", 
      RowBox[{
       RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "Sl_"}], 
      "]"}], ":=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gL", "[", 
         RowBox[{"l", ",", "r", ",", "rp"}], "]"}], "*", 
        RowBox[{"Sl", "[", "rp", "]"}], "*", 
        RowBox[{"rp", "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"rp", ",", "0", ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"r", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Optional", ":", 
     RowBox[{"piecewise", " ", "form", " ", 
      RowBox[{"(", 
       RowBox[{"often", " ", "helps", " ", 
        RowBox[{"Integrate", "/", "NIntegrate"}]}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gLpw", "[", 
      RowBox[{
       RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "rp_"}], 
      "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}]}], ")"}], "*", 
      RowBox[{"Piecewise", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rp", "^", "l"}], "/", 
            RowBox[{"r", "^", 
             RowBox[{"(", 
              RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
           RowBox[{"rp", "<=", "r"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "^", "l"}], "/", 
            RowBox[{"rp", "^", 
             RowBox[{"(", 
              RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
           RowBox[{"rp", ">=", "r"}]}], "}"}]}], "}"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiLpw", "[", 
      RowBox[{
       RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "Sl_"}], 
      "]"}], ":=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gLpw", "[", 
         RowBox[{"l", ",", "r", ",", "rp"}], "]"}], "*", 
        RowBox[{"Sl", "[", "rp", "]"}], "*", 
        RowBox[{"rp", "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"rp", ",", "0", ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"r", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Example", " ", 
     RowBox[{"usage", ":", 
      RowBox[{"Define", " ", "a", " ", "source", " ", "mode", " ", "S_l", 
       RowBox[{"(", "r", ")"}], " ", "and", " ", "compute", " ", 
       "\[CapitalPhi]_l", 
       RowBox[{"(", "r", ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SlExample", "[", "r_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", "r"}], "]"}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"replace", " ", "with", " ", "your", " ", 
     RowBox[{"S_l", "[", "r", "]"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"phi2", "[", "r_", "]"}], ":=", 
     RowBox[{"PhiLpw", "[", 
      RowBox[{"2", ",", "r", ",", "SlExample"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"l", "=", 
     RowBox[{"2", " ", "mode"}]}], "*)"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.979210768408031*^9, 3.979210768409789*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a92bfc3b-93d8-4ca4-8bf5-1cf430ff4815"],

