Cell[CellGroupData[{

Cell["Integrate along contour", "Section",
 CellChangeTimes->{{3.979362098758101*^9, 
  3.979362104587019*^9}},ExpressionUUID->"eb06a527-6a2f-4a3a-8d1d-\
6200b6054690"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "BuildPhiLContourFast", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BuildPhiLContourFast", "[", 
    RowBox[{
     RowBox[{"l_Integer", "?", "NonNegative"}], ",", "Sl_", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a0_", "?", "NumericQ"}], ",", 
       RowBox[{"a1_", "?", "NumericQ"}]}], "}"}], ",", 
     RowBox[{"n_Integer", ":", "2000"}], ",", 
     RowBox[{"wp_Integer", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pref", "=", 
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}]}], ",", "agrid", ",", 
       "da", ",", "Fvals", ",", "Gvals", ",", "Avals", ",", "Bvals", ",", 
       "Aifun", ",", "Bifun", ",", "B1"}], "}"}], ",", 
     RowBox[{"(*", "contour", "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"\[Gamma]", "[", "a_", "]"}], ":=", 
       RowBox[{"a", "+", 
        RowBox[{"I", " ", "J", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "width"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "z0"}], ")"}], "^", "2"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Gamma]p", "[", "a_", "]"}], ":=", 
       RowBox[{"1", "+", 
        RowBox[{"I", " ", "J", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "width"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "z0"}], ")"}], "^", "2"}]}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "width", " ", 
           RowBox[{"(", 
            RowBox[{"a", "-", "z0"}], ")"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"agrid", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{"a0", ",", "a1", ",", "n"}], "]"}], ",", "wp"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"da", "=", 
       RowBox[{"Differences", "[", "agrid", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"sample", " ", "integrands"}], "*)"}], 
      RowBox[{"Fvals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Gamma]", "[", "#", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"l", "+", "2"}], ")"}]}], "*", 
          RowBox[{"Sl", "[", 
           RowBox[{"\[Gamma]", "[", "#", "]"}], "]"}], "*", 
          RowBox[{"\[Gamma]p", "[", "#", "]"}]}], "&"}], "/@", "agrid"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Gvals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Gamma]", "[", "#", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "-", "l"}], ")"}]}], "*", 
          RowBox[{"Sl", "[", 
           RowBox[{"\[Gamma]", "[", "#", "]"}], "]"}], "*", 
          RowBox[{"\[Gamma]p", "[", "#", "]"}]}], "&"}], "/@", "agrid"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"cumulative", " ", "trapezoid", " ", "integrals"}], "*)"}], 
      RowBox[{"Avals", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"da", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Most", "[", "Fvals", "]"}], "+", 
              RowBox[{"Rest", "[", "Fvals", "]"}]}], ")"}], "/", "2"}]}], 
          "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Bvals", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"da", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Most", "[", "Gvals", "]"}], "+", 
              RowBox[{"Rest", "[", "Gvals", "]"}]}], ")"}], "/", "2"}]}], 
          "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Aifun", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"agrid", ",", "Avals"}], "}"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Bifun", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"agrid", ",", "Bvals"}], "}"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"B1", "=", 
       RowBox[{"Bifun", "[", "a1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rr", "=", 
            RowBox[{"N", "[", "r", "]"}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rr", "<", "a0"}], "||", 
             RowBox[{"rr", ">", "a1"}]}], ",", "Indeterminate", ",", 
            RowBox[{"pref", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Aifun", "[", "rr", "]"}], "/", 
                RowBox[{"rr", "^", 
                 RowBox[{"(", 
                  RowBox[{"l", "+", "1"}], ")"}]}]}], "+", 
               RowBox[{
                RowBox[{"rr", "^", "l"}], "*", 
                RowBox[{"(", 
                 RowBox[{"B1", "-", 
                  RowBox[{"Bifun", "[", "rr", "]"}]}], ")"}]}]}], ")"}]}]}], 
           "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.979288907579267*^9, 3.9792889075805693`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"25c5f5a3-771a-4245-8601-72d94d5093f7"],

Cell[BoxData[
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"phiContour", "[", "ld", "]"}], "=", 
       RowBox[{"BuildPhiLContourFast", "[", 
        RowBox[{"ld", ",", 
         RowBox[{"ExtendedDiracSource", "[", "ld", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.05", ",", "10"}], "}"}], ",", "3000", ",", "40"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pltCont", "[", "ld", "]"}], "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{
             RowBox[{"phiContour", "[", "ld", "]"}], "[", "r", "]"}]}], ",", 
           RowBox[{"Im", "@", 
            RowBox[{
             RowBox[{"phiContour", "[", "ld", "]"}], "[", "r", "]"}]}], ",", 
           RowBox[{"PhiLpwDelta", "[", "ld", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "1", ",", "9"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"ld", ",", "0", ",", "ldmax"}], "}"}]}], "]"}], ",", "ld"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9793584223686857`*^9, 3.979358488935444*^9}, {
   3.979358648723426*^9, 3.979358672660297*^9}, 3.979363834367133*^9, {
   3.979363906033402*^9, 3.9793639063458843`*^9}, {3.979637061555142*^9, 
   3.979637068206409*^9}},
