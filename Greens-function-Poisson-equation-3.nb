Cell[BoxData[{
 RowBox[{
  RowBox[{"J", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"width", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]", "[", "a_", "]"}], ":=", 
   RowBox[{"a", "+", 
    RowBox[{"I", " ", "J", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "width"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "-", "z0"}], ")"}], "^", "2"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]p", "[", "a_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "a", "]"}], ",", "a"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]pp", "[", "a_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "a", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"l", "\[Dash]", 
    RowBox[{
     RowBox[{"mode", " ", "kernel", " ", "for", " ", 
      RowBox[{"1", "/"}]}], "|", 
     RowBox[{"x", "-", 
      RowBox[{"x", "'"}]}], "|", 
     RowBox[{"(", 
      RowBox[{"your", " ", "earlier", " ", "gLpw"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gLpw", "[", 
     RowBox[{
      RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "rp_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"Pi", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}]}], ")"}], "*", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rp", "^", "l"}], "/", 
           RowBox[{"r", "^", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
          RowBox[{"rp", "<=", "r"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "^", "l"}], "/", 
           RowBox[{"rp", "^", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
          RowBox[{"rp", ">=", "r"}]}], "}"}]}], "}"}], "]"}]}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Your", " ", "source", " ", "mode", " ", "as", " ", "a", " ", "function", " ",
     "of", " ", "rp", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"example", ":", "l"}], "=", 
      RowBox[{
       RowBox[{"0", " ", "delta"}], "-", 
       RowBox[{"mode", " ", "you", " ", "built"}]}]}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Assumes", " ", "you", " ", "already", " ", "have", " ", 
    RowBox[{"SdeltaAnalyticmodesF", "[", "l", "]"}], " ", "defined"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"SdeltaAnalyticmodesF", "[", 
      RowBox[{"l_Integer", "?", "NonNegative"}], "]"}], ":=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "rp", "}"}], ",", "..."}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Contour", "-", 
     RowBox[{"convolution", " ", "for", " ", 
      RowBox[{"\[Del]", "^", "2"}], " ", "\[CapitalPhi]_l"}]}], "=", 
    RowBox[{
     RowBox[{"S_l", " ", "with", " ", 
      RowBox[{"1", "/"}]}], "|", 
     RowBox[{"x", "-", 
      RowBox[{"x", "'"}]}], "|", "kernel"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhiLContour", "[", 
    RowBox[{
     RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "Sl_", ",", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "a0_", ",", "a1_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi"}], ")"}]}], ")"}], "*", 
      RowBox[{"gLpw", "[", 
       RowBox[{"l", ",", "r", ",", 
        RowBox[{"\[Gamma]", "[", "a", "]"}]}], "]"}], "*", 
      RowBox[{"ExtendedDiracSource", "[", 
       RowBox[{"0", ",", 
        RowBox[{"\[Gamma]", "[", "a", "]"}]}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]", "[", "a", "]"}], "^", "2"}], ")"}], "*", 
      RowBox[{"\[Gamma]p", "[", "a", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "a0", ",", "a1"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<LocalAdaptive\>\"", ",", 
        RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}], ",", 
     RowBox[{"WorkingPrecision", "->", "50"}], ",", 
     RowBox[{"AccuracyGoal", "->", "20"}], ",", 
     RowBox[{"PrecisionGoal", "->", "20"}]}], "]"}]}], ";"}], "\n"}], "Input",\

