Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PhiLpwSolve", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Solves", " ", 
     RowBox[{"\[Del]", "^", "2"}], " ", "\[CapitalPhi]_l"}], "=", 
    RowBox[{
     RowBox[{"S_l", " ", "when", " ", "gLpw", " ", "is", " ", "the", " ", 
      RowBox[{"1", "/"}]}], "|", 
     RowBox[{"x", "-", 
      RowBox[{"x", "'"}]}], "|", 
     RowBox[{"kernel", " ", "expansion"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PhiLpwSolve", "[", 
    RowBox[{
     RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_", ",", "Sl_"}], 
    "]"}], ":=", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"r", ">", "0"}], ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "Pi"}], ")"}]}], ")"}], "*", 
          RowBox[{"gLpw", "[", 
           RowBox[{"l", ",", "r", ",", "rp"}], "]"}], "*", 
          RowBox[{"Sl", "[", "rp", "]"}], "*", 
          RowBox[{"rp", "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"rp", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
       RowBox[{"r", ">", "0"}]}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979212340322407*^9, 3.979212340324366*^9}},
