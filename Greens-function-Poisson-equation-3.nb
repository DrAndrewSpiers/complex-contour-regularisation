Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"SdeltaAnalyticmodes", ",", "SdeltaAnalyticmodesF"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SdeltaAnalyticmodes", "[", 
     RowBox[{
      RowBox[{"l_Integer", "?", "NonNegative"}], ",", "r_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "4"}], " ", "Pi"}], ")"}], " ", 
            RowBox[{
             RowBox[{"DiracDelta", "[", 
              RowBox[{"r", "-", "z0"}], "]"}], "/", 
             RowBox[{"r", "^", "2"}]}], "*", 
            RowBox[{"DiracDelta", "[", 
             RowBox[{"\[Mu]", "-", "1"}], "]"}], "*", 
            RowBox[{"DiracDelta", "[", 
             RowBox[{"\[Phi]", "-", "Pi"}], "]"}], "*", 
            RowBox[{"SphericalHarmonicY", "[", 
             RowBox[{"l", ",", "0", ",", 
              RowBox[{"ArcCos", "[", "\[Mu]", "]"}], ",", "\[Phi]"}], "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", 
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "\[Element]", "Reals"}], ",", 
          RowBox[{"z0", "\[Element]", "Reals"}], ",", 
          RowBox[{"r", ">", "0"}]}], "}"}]}]}], "]"}], "/.", " ", 
     RowBox[{
      RowBox[{"HeavisideTheta", "[", "0", "]"}], "->", "1"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Make", " ", "it", " ", "a", " ", "function", " ", "of", " ", "the", " ", 
    "dummy", " ", "integration", " ", "variable"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SdeltaAnalyticmodesF", "[", 
    RowBox[{"l_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "rp", "}"}], ",", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"SdeltaAnalyticmodes", "[", 
       RowBox[{"l", ",", "rp"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.979212034369022*^9, 3.979212034374227*^9}},
