Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"SlExample", ",", "PhiLFast", ",", "phi2Fast"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SlExample", "[", 
     RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", "r"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PhiLFast", "[", 
     RowBox[{
      RowBox[{"l_Integer", "?", "NonNegative"}], ",", "Sl_", ",", 
      RowBox[{"r_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pref", "=", 
         RowBox[{"4", " ", 
          RowBox[{"Pi", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}]}]}], ",", "i1", ",",
         "i2"}], "}"}], ",", 
      RowBox[{
       RowBox[{"i1", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rp", "^", 
            RowBox[{"(", 
             RowBox[{"l", "+", "2"}], ")"}]}], " ", 
           RowBox[{"Sl", "[", "rp", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"rp", ",", "0", ",", "r"}], "}"}], ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<LocalAdaptive\>\"", ",", 
             RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"i2", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rp", "^", 
            RowBox[{"(", 
             RowBox[{"1", "-", "l"}], ")"}]}], " ", 
           RowBox[{"Sl", "[", "rp", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"rp", ",", "r", ",", "Infinity"}], "}"}], ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<LocalAdaptive\>\"", ",", 
             RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pref", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"i1", "/", 
           RowBox[{"r", "^", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}]}], "+", 
          RowBox[{
           RowBox[{"r", "^", "l"}], "*", "i2"}]}], ")"}]}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phi2Fast", "[", 
     RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"PhiLFast", "[", 
     RowBox[{"2", ",", "SlExample", ",", "r"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"phi2Fast", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "1", ",", "2"}], "}"}]}], "]"}], "\n"}], "Input",
