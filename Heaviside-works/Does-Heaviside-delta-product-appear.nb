Cell["\<\
The first order function is smooth at r=r_0, so first-order field times by \
two radial derivatives of a first-order field might appear to have a \
Heaviside times by a delta, 
but this is just because we used Heavisides rather than absolute values to \
express the first-order fields.\
\>", "Text",
 CellChangeTimes->{{3.988435600578271*^9, 
  3.98843570588197*^9}},ExpressionUUID->"cafd730c-7f37-48bf-a21c-\
935edcd7fb25"]
},
