Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Clear", " ", "symbols", " ", "to", " ", "prevent", " ", 
    "conflicts"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "HLog", ",", "ExtendedDelta", ",", "contour", ",", "t", ",", "r0Val", ",",
       "rStart", ",", "rEnd", ",", "R"}], "]"}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Define", " ", "the", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLog", "[", 
      RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"I", "/", "Pi"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "-", "r0"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtendedDelta", "[", 
      RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
     RowBox[{"I", "/", 
      RowBox[{"(", 
       RowBox[{"Pi", " ", 
        RowBox[{"(", 
         RowBox[{"r", "-", "r0"}], ")"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Set", " ", "parameters", " ", "for", " ", "the", " ", 
     "expanded", " ", "contour"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r0Val", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "2.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Radius", " ", "of", " ", "the", " ", "semi"}], "-", "circle"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"rStart", "=", 
     RowBox[{"-", "R"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rEnd", "=", "R"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Parameterize", " ", "a", " ", "semi"}], "-", 
     RowBox[{"circle", " ", "of", " ", "radius", " ", "R"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"contour", "[", "t_", "]"}], ":=", 
     RowBox[{"R", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "Pi", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "t"}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Perform", " ", "the", " ", "contour", " ", "integration", " ",
      "numerically"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contourIntegral", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"ExtendedDelta", "[", 
          RowBox[{
           RowBox[{"contour", "[", "t", "]"}], ",", "r0Val"}], "]"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Result of Contour Integration: \>\"", ",", 
      RowBox[{"Chop", "[", "contourIntegral", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Evaluate", " ", "the", " ", "endpoints", " ", "using", " ", 
     "the", " ", "HLog", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HeavisideDiff", "=", 
     RowBox[{
      RowBox[{"HLog", "[", 
       RowBox[{"rEnd", ",", "r0Val"}], "]"}], "-", 
      RowBox[{"HLog", "[", 
       RowBox[{"rStart", ",", "r0Val"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Result of HLog[\>\"", ",", "rEnd", ",", "\"\<] - HLog[\>\"",
       ",", "rStart", ",", "\"\<]: \>\"", ",", 
      RowBox[{"Simplify", "[", "HeavisideDiff", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "Verification", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"contourIntegral", "-", "HeavisideDiff"}], "]"}], "<", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{
     "Print", "[", "\"\<Success: The contour integral matches the HLog \
boundary values!\>\"", "]"}], ",", 
     RowBox[{"Print", "[", "\"\<Warning: Mismatch detected.\>\"", "]"}]}], 
    "]"}]}]}]], "Input",
