   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], "+", "\[Pi]"}], ")"}], " ", "r"}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"r", "-", "r0"}], ")"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"r", "-", "r0"}], "]"}]}]}], "\[Pi]"]}]], "Input",
