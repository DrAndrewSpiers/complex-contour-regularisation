eab5d5b02f7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z0", "=", "5"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"position", " ", "of", " ", "source", " ", "peak"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "=", "1"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Gaussian", " ", "height"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Contour", " ", "definition"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", "a_", "]"}], ":=", 
    RowBox[{"a", "+", 
     RowBox[{"I", " ", "J", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "10"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", "z0"}], ")"}], "^", 
         RowBox[{"(", "2", ")"}]}]}], "]"}]}]}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]p", "[", "a_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"\[Gamma]", "[", "a", "]"}], ",", "a"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]pp", "[", "a_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "a", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", " ", "in", " ", "the", " ", "complex", " ", "plane"}], ",", 
    RowBox[{"clipping", " ", "the", " ", "huge", " ", "tails", " ", "in", " ", 
     RowBox[{"Im", "[", "z", "]"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"\[Gamma]", "[", "a", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"\[Gamma]", "[", "a", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
