Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Initialization", " ", "and", " ", "Definitions"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"HLog", ",", "ExtendedDelta", ",", "contour", ",", "t"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "theoretical", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLog", "[", "z_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"I", "/", "Pi"}], " ", 
       RowBox[{"Log", "[", "z", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtendedDelta", "[", "z_", "]"}], ":=", 
     RowBox[{"I", "/", 
      RowBox[{"(", 
       RowBox[{"Pi", " ", "z"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Define", " ", "the", " ", "semi"}], "-", 
      RowBox[{"circular", " ", "contour", " ", "from", " ", "z"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], " ", "to", " ", "z"}], "=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"contour", "[", "t_", "]"}], ":=", 
     RowBox[{"2", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "Pi", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "t"}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Initial", " ", "Condition", " ", "Formulation"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "starting", " ", "value", " ", "of", " ", "the", " ", 
      "integral", " ", "must", " ", "match", " ", "the", " ", "function", " ",
       "at", " ", "t"}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initialValue", "=", 
     RowBox[{"HLog", "[", 
      RowBox[{"contour", "[", 
       RowBox[{"-", "0.5"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Initial value HLog[-1] is: \>\"", ",", 
      RowBox[{"Simplify", "[", "initialValue", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Differential", " ", "Equation", " ", "Setup", " ", "for", " ",
      "the", " ", "Contour", " ", "Integral"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "use", " ", "NDSolveValue", " ", "to", " ", "sweep", " ", 
     "the", " ", "integral", " ", "along", " ", "the", " ", "contour", " ", 
     "continuously"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"integratedHLog", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"ExtendedDelta", "[", 
            RowBox[{"contour", "[", "t", "]"}], "]"}], "*", 
           RowBox[{
            RowBox[{"contour", "'"}], "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{"-", "0.5"}], "]"}], "==", "initialValue"}]}], "}"}], ",", 
       "y", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Compute", " ", "Maximum", " ", "Error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "sample", " ", "the", " ", "difference", " ", "between", " ", 
     "the", " ", "integrated", " ", "result", " ", "and", " ", "the", " ", 
     "theoretical", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errorArray", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"integratedHLog", "[", "t", "]"}], "-", 
         RowBox[{"HLog", "[", 
          RowBox[{"contour", "[", "t", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1", ",", "0.01"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum numerical deviation along the contour: \>\"", ",", 
      RowBox[{"Max", "[", "errorArray", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Visualization", " ", "of", " ", "the", " ", "Match"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "plot", " ", "the", " ", "Real", " ", "and", " ", "Imaginary", 
     " ", "parts", " ", "of", " ", "both", " ", 
     RowBox[{"functions", ".", "The"}], " ", "Dashed", " ", "lines", " ", 
     RowBox[{"(", "Integrated", ")"}], " ", "will", " ", "perfectly", " ", 
     "overlay", " ", "the", " ", "Thick", " ", "lines", " ", 
     RowBox[{
      RowBox[{"(", "Theoretical", ")"}], "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"HLog", "[", 
         RowBox[{"contour", "[", "t", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Re", "[", 
        RowBox[{"integratedHLog", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"HLog", "[", 
         RowBox[{"contour", "[", "t", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"integratedHLog", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Dashed"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"DarkGreen", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Orange", ",", "Dashed"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Theoretical Re[HLog]\>\"", 
        ",", "\"\<Integrated Re[HLog]\>\"", 
        ",", "\"\<Theoretical Im[HLog]\>\"", 
        ",", "\"\<Integrated Im[HLog]\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Path Parameter t\>\"", ",", "\"\<Function Value\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Continuous Agreement of HLog and Integrated Delta\>\""}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.988445427876397*^9, 3.9884454278777037`*^9}, 
   3.988446850630777*^9, {3.988795288511321*^9, 3.9887954005022793`*^9}},
 CellLabel->
  "In[765]:=",ExpressionUUID->"dad8dc54-6ad5-4b8e-8908-379fa2913937"],

