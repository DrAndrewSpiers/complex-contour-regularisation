Cell[CellGroupData[{

Cell["Integrate HLog along Contour", "Subsection",
 CellChangeTimes->{{3.988444849101206*^9, 
  3.9884448592920732`*^9}},ExpressionUUID->"bc4dba69-53b5-4d4c-8eb0-\
02fa1527103e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "previous", " ", "definitions"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "HLog", ",", "ExtendedDelta", ",", "r", ",", "r0", ",", "z", ",", "t"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Define", " ", "the", " ", "Complex", " ", "Heaviside", " ", 
     "Function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLog", "[", 
      RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"I", "/", "Pi"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "-", "r0"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Derive", " ", "the", " ", "Extended", " ", "Dirac", " ", 
     "Delta"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtendedDelta", "[", 
      RowBox[{"r_", ",", "r0_"}], "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"HLog", "[", 
        RowBox[{"r", ",", "r0"}], "]"}], ",", "r"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The extended Dirac Delta is analytically defined as: \>\"", ",", 
     RowBox[{"ExtendedDelta", "[", 
      RowBox[{"r", ",", "r0"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Symbolic", " ", "Indefinite", " ", "Integration"}], 
    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "check", " ", "if", " ", "Mathematica", " ", "recovers", " ", 
     "the", " ", "Log", " ", "term", " ", "symbolically"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"symbolicIntegral", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"ExtendedDelta", "[", 
        RowBox[{"r", ",", "r0"}], "]"}], ",", "r"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Symbolic indefinite integral yields: \>\"", ",", 
     "symbolicIntegral"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.988445117458993*^9, 3.988445117460554*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"a2eede3e-f3b9-4ea6-8d43-df654b7cf2c9"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"The extended Dirac Delta is analytically defined as: \"\>", "\[InvisibleSpace]", 
   FractionBox["\[ImaginaryI]", 
    RowBox[{"\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"r", "-", "r0"}], ")"}]}]]}],
  SequenceForm[
  "The extended Dirac Delta is analytically defined as: ", Complex[0, 1] 
   Pi^(-1)/($CellContext`r - $CellContext`r0)],
  Editable->False]], "Print",
 CellChangeTimes->{3.988445127897029*^9},
 CellLabel->
  "During evaluation of \
In[246]:=",ExpressionUUID->"8bae33b1-718f-4f4c-ad63-f44dc03c11c6"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Symbolic indefinite integral yields: \"\>", "\[InvisibleSpace]", 
   FractionBox[
