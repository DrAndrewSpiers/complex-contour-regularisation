Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Set", " ", "parameters", " ", "for", " ", "the", " ", 
    "contour"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"r0Val", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rStart", "=", 
     RowBox[{"-", "2.0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rEnd", "=", "2.0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Parameterize", " ", "a", " ", "semi"}], "-", 
     RowBox[{"circle", " ", "in", " ", "the", " ", "upper", " ", "half"}], "-", 
     RowBox[{"plane", " ", "from"}], "-", 
     RowBox[{"1", " ", "to", " ", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "As", " ", "t", " ", "goes", " ", "from", " ", "0", " ", "to", " ", 
      "1"}], ",", 
     RowBox[{
     "the", " ", "angle", " ", "goes", " ", "from", " ", "Pi", " ", "to", " ",
       "0"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"contour", "[", "t_", "]"}], ":=", 
     RowBox[{"2", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "Pi", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "t"}], ")"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "contour", " ", "to", " ", "verify", " ", "the", 
     " ", "path", " ", "avoids", " ", "the", " ", "origin"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"contour", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"contour", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Re(z)\>\"", ",", "\"\<Im(z)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Integration Contour in Complex Plane\>\""}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
