 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Log0", "[", 
        RowBox[{"r", "-", "r0"}], "]"}]}], "\[Pi]"]}], ")"}], 
   RowBox[{"\[DifferentialD]", "r"}]}]}]], "Output",
