Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"HLog0", "[", 
     RowBox[{"r", ",", "r0"}], "]"}], ",", "r"}], "]"}], "//", 
  "FullSimplify"}]], "Input",
