Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "contour", " ", "exactly", " ", "as",
     " ", "in", " ", "your", " ", "notebook"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"contour", "[", "t_", "]"}], ":=", 
     RowBox[{"2", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "Pi", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "t"}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "branch", " ", "cut", " ", "for", " ",
      "the", " ", "principal", " ", 
     RowBox[{"Log", "[", "z", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"negative", " ", "real", " ", "axis"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"branchCut", "=", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Visualize", " ", "the", " ", "complex", " ", "plane"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"contour", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"contour", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Blue", ",", "Thick"}], "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Add", " ", "the", " ", "branch", " ", "cut"}], ",", "origin", 
       ",", 
       RowBox[{
       "and", " ", "the", " ", "starting", " ", "point", " ", "of", " ", 
        "the", " ", "contour"}]}], "*)"}], 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Thick", ",", "Dashed"}], "]"}], ",", 
        "branchCut", ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", 
          RowBox[{"PointSize", "[", "Large", "]"}]}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Origin\>\"", ",", "12", ",", "Black", ",", 
            RowBox[{"Background", "->", "White"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "0.3"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"DarkGreen", ",", 
          RowBox[{"PointSize", "[", "Large", "]"}]}], "]"}], ",", 
        RowBox[{"Point", "[", 
