 CellLabel->
  "In[214]:=",ExpressionUUID->"ca87d99c-e7ed-4adb-9bd3-4f395db21fa6"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "+", "\[Pi]"}], ")"}], " ", "r"}], "+", 
   
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{"r", "-", "r0"}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"r", "-", "r0"}], "]"}]}]}], "\[Pi]"]], "Output",
 CellChangeTimes->{{3.988437055065362*^9, 3.98843712011443*^9}},
 CellLabel->
  "Out[214]=",ExpressionUUID->"49d8ca11-e957-4bfa-80af-ca7bf4e31849"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"Kink", "[", 
   RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
