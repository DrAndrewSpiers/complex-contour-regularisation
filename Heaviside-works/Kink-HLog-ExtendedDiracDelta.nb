Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"HLog", "[", 
     RowBox[{"r", ",", "r0"}], "]"}], ",", "r"}], "]"}], "//", 
  "FullSimplify"}]], "Input",
