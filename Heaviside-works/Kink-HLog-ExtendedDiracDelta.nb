Notebook[{

Cell[CellGroupData[{
Cell["Define Log0", "Subsection",
 CellChangeTimes->{{3.9724484772264137`*^9, 
  3.972448480786335*^9}},ExpressionUUID->"3e807684-8041-400b-be7e-\
09bef559334a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"Arg0", ",", "Log0"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Arg", " ", 
      RowBox[{"in", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", "\[Pi]"}]}]}]}], ")"}], "\[Dash]", 
    RowBox[{"cut", " ", "on", " ", "positive", " ", "real", " ", "axis"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Arg0", "[", 
     RowBox[{"z_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"Arg", "[", "z", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Theta]", "<", "0"}], ",", 
        RowBox[{"\[Theta]", "+", 
         RowBox[{"2", " ", "Pi"}]}], ",", "\[Theta]"}], "]"}]}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Custom", " ", "logarithm", " ", "with", " ", "that", " ", "Arg"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Log0", "[", 
     RowBox[{"z_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"Abs", "[", "z", "]"}], "]"}], "+", 
     RowBox[{"I", " ", 
      RowBox[{"Arg0", "[", "z", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"For", " ", "symbolic", " ", 
       RowBox[{"z", ":", 
        RowBox[{
        "treat", " ", "Log0", " ", "as", " ", "ordinary", " ", "Log", " ", 
         RowBox[{"Log0", "[", "z_", "]"}]}]}]}], "/;", 
      RowBox[{"!", 
       RowBox[{"NumericQ", "[", "z", "]"}]}]}], ":=", 
     RowBox[{"Log", "[", "z", "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ArcTanh0", "[", 
     RowBox[{"z_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log0", "[", 
        RowBox[{"1", "+", "z"}], "]"}], "-", 
       RowBox[{"Log0", "[", 
        RowBox[{"1", "-", "z"}], "]"}]}], ")"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9721251189368973`*^9, 3.9721251189368973`*^9}, {
   3.972194849793648*^9, 3.9721949099811726`*^9}, {3.9721950904960537`*^9, 
   3.972195091416441*^9}, {3.972195200024372*^9, 3.9721952356492233`*^9}, {
   3.9721953051236057`*^9, 3.972195322851364*^9}, {3.9721953957602463`*^9, 
   3.972195398662836*^9}, 3.972219121651926*^9},
 CellLabel->
  "In[229]:=",ExpressionUUID->"4d610b7f-1f78-4086-9917-a86ebbfb083c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["HLog", "Subsection",
 CellChangeTimes->{{3.988437275000969*^9, 
  3.9884372762236557`*^9}},ExpressionUUID->"9a8bbb84-e603-420c-87ce-\
d53e0ae2bb2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HLog", "[", 
   RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
  RowBox[{"1", "+", " ", 
   RowBox[{
    RowBox[{"I", "/", "Pi"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"r", "-", "r0"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9744404752342463`*^9, 3.9744405161798*^9}, {
  3.9744414054900627`*^9, 3.9744414064307337`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"0dd1701e-e7e3-4ad8-92f0-76f9d9d723b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"HLog", "[", 
       RowBox[{"r", ",", "5"}], "]"}]}], ",", 
     RowBox[{"Im", "@", 
      RowBox[{"HLog", "[", 
       RowBox[{"r", ",", "5"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "10"}], "}"}]}], "]"}]], "Input",
