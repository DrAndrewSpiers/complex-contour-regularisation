   "5.", " ", "Perform", " ", "the", " ", "contour", " ", "integration", " ", 
    "numerically"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"dz", "=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}], " ", "dt"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"contourIntegral", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"ExtendedDelta", "[", 
          RowBox[{
           RowBox[{"contour", "[", "t", "]"}], ",", "r0Val"}], "]"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"contour", "[", "t", "]"}], ",", "t"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Result of Contour Integration: \>\"", ",", 
     RowBox[{"Chop", "[", "contourIntegral", "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "6.", " ", "Evaluate", " ", "the", " ", "endpoints", " ", "using", " ", 
     "the", " ", "proposed", " ", "HLog", " ", "function"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Note", ":", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"-", "1"}], "]"}], " ", "in", " ", "Mathematica", " ", 
      "evaluates", " ", "to", " ", "I", " ", "Pi"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HeavisideDiff", "=", 
     RowBox[{
      RowBox[{"HLog", "[", 
       RowBox[{"rEnd", ",", "r0Val"}], "]"}], "-", 
      RowBox[{"HLog", "[", 
       RowBox[{"rStart", ",", "r0Val"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Result of HLog[1] - HLog[-1]: \>\"", ",", 
     RowBox[{"Simplify", "[", "HeavisideDiff", "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"7.", " ", "Verification", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"contourIntegral", "-", "HeavisideDiff"}], "]"}], "<", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{
     "Print", "[", "\"\<Success: The contour integral matches the HLog \
boundary values!\>\"", "]"}], ",", 
     RowBox[{"Print", "[", "\"\<Warning: Mismatch detected.\>\"", "]"}]}], 
    "]"}]}]}]], "Input",
