Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solAnalytic", "=", 
  RowBox[{
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ODE", "[", 
        RowBox[{"r", ",", "0", ",", "SourceDelta"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "1", "]"}], "==", 
        RowBox[{"BoundaryConditions", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "'"}], "[", "1", "]"}], "==", 
        RowBox[{"BoundaryConditions", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\[Psi]", ",", "r"}],
     "]"}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.974801547263289*^9, 3.974801551964216*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"76fa2856-8080-4672-98e3-a0607d949f8a"],

Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", "r", "}"}], ",", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", "-", 
     RowBox[{"\[ImaginaryI]", " ", "r"}], "-", 
     RowBox[{"100", " ", "\[Pi]", " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{
        RowBox[{"-", "5"}], "+", "r"}], "]"}]}], "+", 
     RowBox[{"20", " ", "\[Pi]", " ", "r", " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{
        RowBox[{"-", "5"}], "+", "r"}], "]"}]}], "+", 
