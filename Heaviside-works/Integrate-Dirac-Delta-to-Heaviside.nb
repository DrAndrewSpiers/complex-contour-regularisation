Cell[CellGroupData[{
Cell["Imaginary part of Heaviside", "Section",
 CellChangeTimes->{{3.974447902822053*^9, 3.974447922725922*^9}, {
  3.974780451063224*^9, 
  3.974780451585951*^9}},ExpressionUUID->"dc0614b2-fdb6-456e-8fce-\
e3426d017862"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z0", "=", "5"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"position", " ", "of", " ", "source", " ", "peak"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "=", "1"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Gaussian", " ", "height"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Contour", " ", "definition"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", "a_", "]"}], ":=", 
    RowBox[{"a", "+", 
     RowBox[{"I", " ", "J", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "10"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", "z0"}], ")"}], "^", 
         RowBox[{"(", "2", ")"}]}]}], "]"}]}]}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]p", "[", "a_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"\[Gamma]", "[", "a", "]"}], ",", "a"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]pp", "[", "a_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "a", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", " ", "in", " ", "the", " ", "complex", " ", "plane"}], ",", 
    RowBox[{"clipping", " ", "the", " ", "huge", " ", "tails", " ", "in", " ", 
     RowBox[{"Im", "[", "z", "]"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"\[Gamma]", "[", "a", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"\[Gamma]", "[", "a", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Re a\>\"", ",", "\"\<Im a\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9695209493945866`*^9, 3.9695209493945866`*^9}, {
