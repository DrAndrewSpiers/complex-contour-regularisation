Cell[CellGroupData[{

Cell["\<\
Compare integration of Dirac delta function to the extended analytical \
solution with the extended Heaviside (arbitrary boundary conditions)\
\>", "Subsection",
 CellChangeTimes->{{3.9712437952204742`*^9, 3.9712438017338657`*^9}, 
   3.9714999214225063`*^9, {3.97306807791796*^9, 3.97306808769942*^9}, {
   3.973076230726481*^9, 3.9730762314010563`*^9}, {3.973143741164134*^9, 
   3.9731437660325747`*^9}, {3.97444059765666*^9, 3.974440601731681*^9}, {
   3.9887886504316883`*^9, 
   3.988788701659473*^9}},ExpressionUUID->"10968225-58e4-43bf-8417-\
af8eda9a266b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SourceDelta", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"r", "-", "r0"}], "]"}], "/.", 
     RowBox[{"r0", "->", "5"}]}], ",", "r"}], "]"}]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"6adf01b5-0da6-4edb-8596-f89b4d538075"],

Cell[BoxData[
 RowBox[{"DiracDelta", "[", 
  RowBox[{
   RowBox[{"-", "5"}], "+", "r"}], "]"}]], "Output",
 CellChangeTimes->{3.9887883725350027`*^9, 3.988794139864792*^9, 
  3.9940612750399*^9, 3.994061316554131*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"4dcd7dea-5170-49ea-abca-1fbea6460e62"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtendedDiracDelta", "[", 
   RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
  FractionBox["\[ImaginaryI]", 
   RowBox[{"\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{"r", "-", "r0"}], ")"}]}]]}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"44bed048-e5c4-46fc-9c6c-86c85eefb726"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HLog", "[", 
   RowBox[{"r_", ",", "r0_"}], "]"}], ":=", 
  RowBox[{"1", "+", " ", 
   RowBox[{
    RowBox[{"I", "/", "Pi"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"r", "-", "r0"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9744404752342463`*^9, 3.9744405161798*^9}, {
  3.9744414054900627`*^9, 3.9744414064307337`*^9}},
