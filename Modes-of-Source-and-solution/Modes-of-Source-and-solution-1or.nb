Cell[CellGroupData[{

Cell["Replace square roots with Heaviside functions", "Subsection",
 CellChangeTimes->{{3.994164567086933*^9, 
  3.9941645820182657`*^9}},ExpressionUUID->"545a6569-2e40-4fb3-84bd-\
08165f23f17c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Substitute", " ", "the", " ", "coordinate", " ", "functions"}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"s0Subbed", "=", 
     RowBox[{"S0", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", "afunc"}], ",", 
        RowBox[{"b", "->", "bfuncNoAbs"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Force", " ", "Mathematica", " ", "to", " ", "factor", " ", 
     "the", " ", "terms", " ", "and", " ", "resolve", " ", "the", " ", 
     "absolute", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s0Abs", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"s0Subbed", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "\[Element]", "Reals"}], ",", 
          RowBox[{"z0", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Write", " ", "a", " ", "new", " ", "rule", " ", "that", " ", 
     "targets", " ", "the", " ", 
     RowBox[{"Abs", "[", "]"}], " ", "function", " ", "instead", " ", "of", " ",
      "Sqrt"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"absToHeavisideRule", "=", 
     RowBox[{
      RowBox[{"Abs", "[", "x_", "]"}], ":>", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"HeavisideTheta", "[", "x", "]"}]}], "-", "1"}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Apply", " ", "the", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"s0Heaviside", "=", 
    RowBox[{"s0Abs", "/.", " ", "absToHeavisideRule"}]}]}]}]], "Input",
 CellChangeTimes->{{3.994164792088875*^9, 3.994164792090197*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"d103ed04-fe57-41e4-8618-4c9c020bac21"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["\[Pi]"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "-", "z0"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"HeavisideTheta", "[", 
            RowBox[{"r", "-", "z0"}], "]"}]}]}], ")"}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "z0"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{"r", "+", "z0"}], "]"}]}]}], ")"}]}]}], ")"}]}], 
  RowBox[{"r", " ", "z0"}]]], "Output",
 CellChangeTimes->{{3.994164794001938*^9, 3.994164860271571*^9}, 
   3.99416498025305*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"c872c129-9bf7-42ef-a137-9081d9fa48e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s0Heaviside", "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9941650100271273`*^9, 3.9941650107169724`*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"b6e741a2-287b-403b-8574-5cbb4996eba3"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox["\[Pi]"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "z0"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", "z0"}], ")"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"r", "-", "z0"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "z0"}], ")"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"r", "+", "z0"}], "]"}]}]}], ")"}]}], 
  RowBox[{"r", " ", "z0"}]]], "Output",
 CellChangeTimes->{3.994165011186741*^9},
 CellLabel->
  "Out[103]=",ExpressionUUID->"799c6d86-0324-4639-8d03-6728307f8ec0"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToHeaviside", "[", "f_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fSubbed", ",", "fAbs", ",", "fHeaviside"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "1.", " ", "Substitute", " ", "the", " ", "coordinate", " ", 
      "functions"}], "*)"}], 
    RowBox[{
     RowBox[{"fSubbed", "=", 
      RowBox[{"f", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "->", "afunc"}], ",", 
         RowBox[{"b", "->", "bfuncNoAbs"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Force", " ", "Mathematica", " ", "to", " ", "factor", " ", 
       "into", " ", "absolute", " ", "values"}], "*)"}], 
     RowBox[{"fAbs", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"fSubbed", ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "\[Element]", "Reals"}], ",", 
           RowBox[{"z0", "\[Element]", "Reals"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"3.", " ", "Apply", " ", "the", " ", "rule", " ", 
       RowBox[{"(", 
        RowBox[{
        "Make", " ", "sure", " ", "absToHeavisideRule", " ", "is", " ", 
         "already", " ", "defined", " ", "in", " ", "your", " ", "notebook"}],
         ")"}]}], "*)"}], 
     RowBox[{"fHeaviside", "=", 
      RowBox[{"fAbs", "/.", " ", "absToHeavisideRule"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"4.", " ", "Return", " ", "the", " ", "final", " ", "result"}], 
      "*)"}], 
     RowBox[{"fHeaviside", "//", "Simplify"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99416524731561*^9, 3.9941652473185987`*^9}, {
  3.99416531838484*^9, 3.994165319474947*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"4cbb5e33-0e5c-4cc2-b01a-fbf1ca6ac495"],

