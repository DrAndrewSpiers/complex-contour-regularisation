Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"2", " ", 
    SqrtBox[
     FractionBox["1", "a"]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", "b"}]], "-", 
         SqrtBox[
          RowBox[{"1", "+", "b"}]]}], ")"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", "b"}]], "+", 
         SqrtBox[
          RowBox[{"1", "+", "b"}]]}], ")"}]}]}], ")"}], " ", 
    SqrtBox[
     FractionBox["\[Pi]", "3"]]}], 
   SuperscriptBox["b", "2"]]}]], "Output",
