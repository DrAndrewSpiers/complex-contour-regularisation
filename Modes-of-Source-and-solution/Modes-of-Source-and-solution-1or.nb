Cell[BoxData[
 RowBox[{
  RowBox[{"SAnalyticmodes", "[", "l_Integer", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"prefactor", ",", "integrand"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "2", "\[Pi]", " ", "and", " ", "Spherical", " ", "Harmonic", 
      " ", "constants", " ", "simplify", " ", "to", " ", "this", " ", 
      "prefactor"}], "*)"}], 
    RowBox[{
     RowBox[{"prefactor", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Pi", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "l"}], "+", "1"}], ")"}]}], ")"}], "/", "a"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "fully", " ", "algebraic", " ", "integrand", " ", "using", " ",
        "Legendre", " ", "Polynomials"}], "*)"}], 
     RowBox[{"integrand", "=", 
      RowBox[{
       RowBox[{"LegendreP", "[", 
        RowBox[{"l", ",", "x"}], "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"b", " ", "x"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Evaluate", " ", "and", " ", "simplify"}], "*)"}], 
     RowBox[{
      RowBox[{"prefactor", "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{"integrand", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", ">", "0"}], ",", 
            RowBox[{
             RowBox[{"-", "1"}], "<", "b", "<", "1"}]}], "}"}]}]}], "]"}]}], "//",
       "FullSimplify"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9941642563827477`*^9, 3.99416425638356*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"6477c0bd-c60d-4a63-8e91-b39b083da0e6"],

